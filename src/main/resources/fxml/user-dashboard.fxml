<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.mindjavafx.controller.UserDashboardController"
           stylesheets="/styles/modern.css">

    <BorderPane>

    <!-- HEADER (TOP) -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 15px 30px;">
            <!-- Logo/Title -->
            <Label text="MindAudit" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- Navigation Buttons -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button onAction="#showRapportList" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5px; -fx-padding: 8px 15px; -fx-cursor: hand; -fx-font-weight: bold;" text="📋 Rapports" />
                <Button onAction="#handleScanDocument" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-background-radius: 5px; -fx-padding: 8px 15px; -fx-cursor: hand; -fx-font-weight: bold;" text="🔍 Scan Document" />
                <Button onAction="#handleNewRapportTop" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 5px; -fx-padding: 8px 15px; -fx-cursor: hand; -fx-font-weight: bold;" text="+ Nouveau" />
                <Button fx:id="reclamationChatbotButton" text="🤖 Chatbot" onAction="#showReclamationChatbot" 
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-background-radius: 5px; -fx-padding: 8px 15px; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- Export Buttons -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button onAction="#handleExportExcel" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-background-radius: 5px; -fx-padding: 8px 15px; -fx-cursor: hand; -fx-font-weight: bold;" text="📥 Excel" />
                <Button onAction="#handleExportPDF" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5px; -fx-padding: 8px 15px; -fx-cursor: hand; -fx-font-weight: bold;" text="📥 PDF" />
            </HBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <!-- User Info & Action Buttons -->
            <HBox alignment="CENTER" spacing="15">
                <Separator orientation="VERTICAL" prefHeight="30" />

                <!-- Notification Bell -->
                <StackPane>
                    <Button fx:id="notificationButton" onAction="#showNotificationDropdown" 
                            style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 20px; -fx-cursor: hand;" text="🔔" />
                    <Label fx:id="notificationBadge" text="+1" visible="true"
                           style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 50%; -fx-padding: 3px 7px; -fx-font-size: 11px; -fx-font-weight: bold; -fx-min-width: 18px; -fx-min-height: 18px; -fx-alignment: center;" 
                           translateX="12" translateY="-10" />
                </StackPane>
                
                <!-- User Profile -->
                <HBox alignment="CENTER" spacing="10">
                    <Circle fx:id="profileImage" fill="#3498db" radius="20" style="-fx-stroke: white; -fx-stroke-width: 2;" />
                    <VBox spacing="2">
                        <Label fx:id="userNameLabel" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Utilisateur" />
                        <Button onAction="#showSettings" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-padding: 0; -fx-cursor: hand; -fx-font-size: 11px; -fx-underline: true;" text="Mon Profil" />
                    </VBox>
                </HBox>
                
                <!-- Logout Button -->
                <Button fx:id="logoutButton" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5px; -fx-padding: 8px 15px; -fx-cursor: hand;" text="Déconnexion" />
            </HBox>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="0" prefWidth="240" style="-fx-background-color: #1a2332; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0, 3, 0);">

            <!-- Brand header -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #141c2a; -fx-padding: 20;">
                <Label text="MindAudit" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: white;"/>
            </HBox>

            <Label text="NAVIGATION" style="-fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #5a7a9a; -fx-padding: 18 20 8 20;"/>

            <!-- Dashboard -->
            <Button fx:id="dashboardButton" text="🏠 Dashboard" onAction="#showDashboardHome" maxWidth="Infinity"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20; -fx-font-size: 13; -fx-cursor: hand; -fx-font-weight: bold;"/>

            <!-- Entreprise -->
            <Button fx:id="entrepriseButton" text="🏢 Entreprise" onAction="#showEntrepriseManagement" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20; -fx-font-size: 13; -fx-cursor: hand;"/>

            <!-- Rapports & Audits -->
            <Button fx:id="rapportManagementButton" text="📄 Rapports &amp; Audits" onAction="#showRapportManagement" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20; -fx-font-size: 13; -fx-cursor: hand;"/>




            <!-- Réclamations -->
            <Button fx:id="reclamationButton" text="📬 Réclamations" onAction="#showReclamations" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20; -fx-font-size: 13; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="SYSTEME" style="-fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #5a7a9a; -fx-padding: 10 20 8 20;"/>

            <!-- Mon Profil -->
            <Button fx:id="settingsButton" text="👤 Mon Profil" onAction="#showSettings" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20; -fx-font-size: 13; -fx-cursor: hand;"/>

            <Label text="AudiAI Analytics v3.0" style="-fx-text-fill: #3d5166; -fx-font-size: 10px; -fx-padding: 12 20;"/>
        </VBox>
    </left>

    <!-- CONTENT AREA (CENTER) -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #ecf0f1;"/>
    </center>
    </BorderPane>

    <!-- FLOATING CHATBOT -->
    <StackPane pickOnBounds="false" alignment="BOTTOM_RIGHT">
        <padding>
            <Insets bottom="30" right="30"/>
        </padding>
        <VBox fx:id="chatbotWindow" visible="false" managed="false" spacing="15" 
              style="-fx-background-color: #005ce6; -fx-background-radius: 12px; -fx-padding: 20px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);"
              maxWidth="350" maxHeight="500" StackPane.alignment="BOTTOM_RIGHT" translateY="-80">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🤖" style="-fx-font-size: 24px; -fx-background-color: white; -fx-background-radius: 50%; -fx-padding: 5px;"/>
                <Label text="Assistant IA" style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 16px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✖" onAction="#toggleChatbot" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;"/>
            </HBox>
            <ScrollPane fx:id="chatScroll" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="chatMessages" spacing="10"/>
            </ScrollPane>
            <VBox fx:id="chatInputArea" spacing="10">
                <HBox spacing="10" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 20px; -fx-padding: 5px 10px;">
                    <Button text="📎" onAction="#onUploadFile" style="-fx-background-color: transparent; -fx-text-fill: #005ce6; -fx-font-size: 18px; -fx-cursor: hand;"/>
                    <TextField fx:id="tfChatInput" promptText="Écrivez ici..." style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS" onAction="#handleChatSubmit"/>
                    <Button text="➤" onAction="#handleChatSubmit" style="-fx-background-color: transparent; -fx-text-fill: #005ce6; -fx-font-size: 18px; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
            <VBox fx:id="chatUploadArea" visible="false" managed="false" alignment="CENTER" spacing="10">
                <Button text="📁 Téléverser le document de l'entreprise" onAction="#onUploadFile" 
                        style="-fx-background-color: white; -fx-text-fill: #005ce6; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 10px 20px; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
        <Button fx:id="btnFloatingChat" onAction="#toggleChatbot" text="🤖" 
                style="-fx-background-color: #005ce6; -fx-text-fill: white; -fx-font-size: 30px; -fx-background-radius: 50%; -fx-min-width: 60px; -fx-min-height: 60px; -fx-cursor: hand;"/>
    </StackPane>
</StackPane>
